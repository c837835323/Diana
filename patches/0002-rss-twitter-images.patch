@@ -456,6 +469,7 @@ func parseTwitterStatusesFeed(body []byte) (parsedFeed, error) {
 			Author:      author,
 			Content:     text,
 			PublishedAt: published,
+			Images:      images,
 		})
 	}
 	return feed, nil
